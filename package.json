{
  "name": "finstates-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.6",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "pnpm build && pnpm verify:build",
    "deploy": "scripts/deploy.sh",
    "deploy:dry-run": "scripts/deploy.sh --dry-run"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
